# Tabish Web - Environment Configuration Template
# Copy this file to .env for local testing or set these as Cloudflare Secrets / Supabase Vault

# 1. Supabase Database Configuration (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Server-side secret key: configure ONE of these in Cloudflare encrypted Secrets
# Never use a SUPABASE_SECRET_KEY or service-role key in frontend/VITE variables.
SUPABASE_SECRET_KEY=replace-with-server-side-secret
# Alternative if your Supabase project still uses the legacy service-role key:
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret

# 2. Email Notification Provider (Resend, Brevo, SendGrid, or SMTP)
# e.g., Resend API key (re_xxxx)
EMAIL_PROVIDER_API_KEY=re_123456789abcdef
EMAIL_FROM="Tabish Web Leads <onboarding@resend.dev>"
INQUIRY_TO=ta480105@gmail.com

# 3. WhatsApp Notification Settings
WHATSAPP_NUMBER=919507375721
# Optional: WhatsApp Cloud API credentials for automated WhatsApp messaging
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# 4. Server & Port
PORT=3000
NODE_ENV=development
